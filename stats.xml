<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/statTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊  آمار من"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- ===== کارت آمار ===== -->
        <LinearLayout
            android:id="@+id/statCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/card_bg"
            android:elevation="6dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/textStatHabitName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 عادت من"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:gravity="center"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/textStatDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ انجام‌شده: 0 روز"
                android:textSize="17sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/textStatLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳ باقی‌مانده: 30 روز"
                android:textSize="17sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/textStatPercent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 درصد: 0%"
                android:textSize="17sp"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/textStatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌱 تازه شروع کردی"
                android:textSize="16sp"
                android:textColor="#666666"
                android:textStyle="italic"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/btnEditHabit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="✏️  ویرایش عادت"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:background="@drawable/btn_blue_outline" />

        </LinearLayout>

        <TextView
            android:id="@+id/notesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝  یادداشت‌های من"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/notesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔙  برگشت به صفحه اصلی"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_green"
            android:elevation="4dp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
