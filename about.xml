<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/aboutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️  درباره ما"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/aboutCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:background="@drawable/card_bg"
            android:elevation="6dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/aboutAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:text="A"
                android:textSize="56sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="#9C27B0"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/aboutName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="امیرعلی صاعدی"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/aboutBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="«هر روز، یه قدم به بهترین نسخه‌ی خودم نزدیک‌تر»"
                android:textSize="15sp"
                android:textColor="#888888"
                android:textStyle="italic"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutInfoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/card_bg"
            android:elevation="6dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/aboutInstaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷  اینستاگرام:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/aboutInstaValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="amirali.saedi85"
                    android:textSize="16sp"
                    android:textColor="#E91E63"
                    android:gravity="end"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/aboutDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/aboutVersionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱  نسخه:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/aboutVersionValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1.0"
                    android:textSize="16sp"
                    android:textColor="#4CAF50"
                    android:gravity="end"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnOpenInsta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📷  باز کردن اینستاگرام"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#E91E63"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAboutBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔙  برگشت"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#4CAF50" />

    </LinearLayout>
</ScrollView>